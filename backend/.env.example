GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENWEATHER_API_KEY=
# Optional: weather works without any key via Open-Meteo. OpenWeather is only a fallback.

# Database: defaults to local SQLite. For production use a free hosted Postgres
# (Neon / Supabase) and `pip install psycopg2-binary`:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname
# JWT_SECRET=<long random string; auto-generated to backend/.jwt_secret if unset>
# CORS_ORIGINS=https://your-frontend-domain.com
